{
  "name": "noc-system-installer",
  "version": "1.0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "noc-system": "./bin/noc-system.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "next dev",
    "dev:all": "node scripts/run-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:timescale": "node scripts/setup-timescale.mjs",
    "db:migrate:server": "node scripts/migrate-server.mjs",
    "db:migrate:status": "node scripts/migrate-server.mjs --status",
    "role:set": "node scripts/set-role.mjs",
    "seed:accounts": "node scripts/seed-accounts.mjs",
    "db:studio": "drizzle-kit studio",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/test.mjs unit",
    "test:e2e": "node scripts/test.mjs e2e",
    "create:variant": "node scripts/create-variant.mjs",
    "db:up": "node scripts/database.mjs up",
    "db:down": "node scripts/database.mjs down",
    "db:status": "node scripts/database.mjs status",
    "db:logs": "node scripts/database.mjs logs",
    "test:setup": "node scripts/test-setup.mjs",
    "lab:up": "node scripts/lab.mjs up",
    "lab:down": "node scripts/lab.mjs down",
    "lab:status": "node scripts/lab.mjs status",
    "genieacs:up": "docker compose -f compose.genieacs.yaml up -d",
    "genieacs:down": "docker compose -f compose.genieacs.yaml down",
    "genieacs:logs": "docker compose -f compose.genieacs.yaml logs -f",
    "genieacs:status": "docker compose -f compose.genieacs.yaml ps",
    "genieacs:config": "node scripts/genieacs-apply-config.mjs",
    "9router:up": "docker compose -f compose.9router.yaml up -d",
    "9router:down": "docker compose -f compose.9router.yaml down",
    "9router:logs": "docker compose -f compose.9router.yaml logs -f",
    "9router:status": "docker compose -f compose.9router.yaml ps",
    "logto:up": "docker compose -f compose.logto.yaml up -d",
    "logto:down": "docker compose -f compose.logto.yaml down",
    "logto:logs": "docker compose -f compose.logto.yaml logs -f",
    "logto:status": "docker compose -f compose.logto.yaml ps",
    "osrm:download": "curl -fL --create-dirs -o docker/osrm/data/sumatra-latest.osm.pbf https://download.geofabrik.de/asia/indonesia/sumatra-latest.osm.pbf",
    "osrm:prepare": "docker compose -f compose.osrm.yaml run --rm osrm-prepare",
    "osrm:up": "docker compose -f compose.osrm.yaml up -d osrm",
    "osrm:down": "docker compose -f compose.osrm.yaml down",
    "osrm:logs": "docker compose -f compose.osrm.yaml logs -f osrm",
    "simulator:dev": "node scripts/simulator-lab.mjs",
    "benchmark:run": "node scripts/run-benchmark-comparison.mjs",
    "benchmark:db": "node scripts/run-benchmark-db.mjs",
    "image:build": "node scripts/build-images.mjs",
    "image:verify": "node scripts/build-images.mjs --verify",
    "deploy:verify": "node scripts/verify-deploy.mjs",
    "deploy:verify:zero-dummy": "node scripts/verify-zero-dummy.mjs",
    "backend:dev": "node scripts/backend-dev.mjs",
    "backend:build": "go -C backend build -o bin/ ./cmd/server",
    "backend:test": "go -C backend test ./...",
    "backend:check": "go -C backend vet ./... && go -C backend test ./...",
    "upgrade": "node bin/noc-system.mjs upgrade",
    "version": "node bin/noc-system.mjs version"
  },
  "dependencies": {
    "@better-auth/core": "1.7.3",
    "@google/genai": "^2.30.0",
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "16.3.4",
    "better-auth": "1.7.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "drizzle-orm": "0.45.2",
    "googleapis": "^187.0.0",
    "leafer-ui": "^2.3.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.42.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "ssh2": "^1.17.0",
    "uplot": "1.6.32",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
