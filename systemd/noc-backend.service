[Unit]
Description=NOC System Collector & WebSocket Hub (Go Native)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=noc
Group=noc
WorkingDirectory=/srv/noc/current
EnvironmentFile=/srv/noc/shared/.env
Environment=PORT=8080
ExecStart=/srv/noc/current/noc-backend
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Izinkan bind port privileged jika syslog UDP:514 digunakan
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
