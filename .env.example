# PERINGATAN KEAMANAN: berkas ini TERLACAK di Git dan hanya template.
# JANGAN PERNAH menaruh kredensial sungguhan (kata sandi, token, kunci API,
# secret) di sini. Nilai asli taruh di .env.local, yang diabaikan git.
# Semua variabel berakhiran _SECRET, _PASSWORD, _KEY, _TOKEN WAJIB kosong di sini.
# npm run setup creates private local values in .env.local.
# Berkas ini rujukan tunggal seluruh variabel environment sistem.

# ==============================================================================
# 1. Autentikasi & Aplikasi Web (Next.js, Better Auth)
# ==============================================================================
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Proxy di depan aplikasi yang dipercaya (opsional): alamat IP atau rentang CIDR
# dipisah koma, mis. 127.0.0.1,::1 untuk nginx di mesin yang sama atau
# 10.0.0.0/24 untuk load balancer. Alamat klien dari header X-Forwarded-For
# menjadi kunci batas laju login (3 percobaan per 10 detik per alamat).
# Rantai dibaca dari kanan: alamat paling kanan yang BUKAN proxy tepercaya
# dianggap klien, jadi isian palsu di kiri rantai tidak dipakai. Daftarkan HANYA
# proxy yang Anda kendalikan, dan pastikan aplikasi tidak bisa dijangkau tanpa
# lewat proxy itu. Entri yang tidak sah menghentikan aplikasi saat dimulai.
# Kosong (bawaan, tanpa proxy): semua header terusan diabaikan dan semua klien
# berbagi satu batas laju per jalur, supaya header palsu tidak bisa melewatinya.
TRUSTED_PROXIES=

# ==============================================================================
# 2. Database & Pool Koneksi PostgreSQL
# ==============================================================================
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433
# Pool koneksi node-postgres: jumlah maksimum, batas waktu koneksi, dan batas
# waktu koneksi menganggur (milidetik).
PG_MAX_CONNECTIONS=5
PG_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=3000

# ==============================================================================
# 3. Mode Sistem (Data & Perangkat)
# ==============================================================================
# "demo" shows the dashboard with mock data. "live" locks it until at least one
# router or OLT is installed and reachable; users are sent to /setup until then.
DASHBOARD_DATA=demo
# Mode data sistem: demo | live.
DATA_MODE=demo
# Mode bawaan semua perangkat: simulator | real. Tiap perangkat bisa menimpanya
# lewat MIKROTIK_MODE, OLT_MODE, GENIEACS_MODE, atau BILLING_MODE di bawah.
DEVICE_MODE=simulator

# ==============================================================================
# 4. Integrasi Perangkat MikroTik (RouterOS v7)
# ==============================================================================
MIKROTIK_MODE=simulator
MIKROTIK_REST_HOST=10.10.0.1
MIKROTIK_REST_PORT=443
MIKROTIK_REST_USER=noc-monitor
MIKROTIK_REST_PASSWORD=
# MIKROTIK_REST_USE_TLS=true

# ==============================================================================
# 5. Integrasi OLT HSGQ (EPON/GPON)
# ==============================================================================
OLT_MODE=simulator
OLT_HSGQ_HOST=10.10.1.1
OLT_HSGQ_PORT=80
OLT_HSGQ_USER=admin
OLT_HSGQ_PASSWORD=
# OLT_HSGQ_USE_TLS=false

# ==============================================================================
# 6. Integrasi GenieACS TR-069 NBI (CPE/WiFi)
# ==============================================================================
GENIEACS_MODE=simulator
GENIEACS_NBI_URL=http://10.10.2.1:7557
GENIEACS_NBI_USER=acs-operator
GENIEACS_NBI_PASSWORD=
GENIEACS_TIMEOUT_MS=5000

# Pasang GenieACS lewat halaman web admin modem (tombol "Pasang via web ONT" di Inventaris ONU).
# Alamat ACS dan kredensial admin modem diisi di aplikasi (tersimpan terenkripsi di database).
# Hanya batas jaringan yang di sini: modem di luar daftar ini tidak akan dibuka
# (bawaan alamat pribadi RFC 1918 + 100.64.0.0/10, dipisah koma).
# ONT_WEB_ALLOWED_CIDRS=172.16.15.0/24

# ==============================================================================
# 7. Integrasi Billing & Scraper
# ==============================================================================
# Sinkron billing per jam di backend Go (opsional). HIDUP hanya bila BILLING_URL,
# BILLING_USERNAME, BILLING_PASSWORD, dan DATABASE_URL terisi semuanya; kosong
# semua berarti sinkron dimatikan, terisi sebagian membuat backend menolak start.
# Pakai akun billing yang hanya boleh membaca tagihan, dan alamat https://.
# Profil situs (selektor login dan tabel) harus dicocokkan dengan HTML situs
# billing Anda sebelum dipakai; lihat "Sinkron billing (implementasi)" di
# backend/README.md. Jangan menaruh kata sandi sungguhan di berkas yang masuk git.
BILLING_MODE=simulator
BILLING_URL=
BILLING_PORTAL_URL=
BILLING_USERNAME=
BILLING_PASSWORD=
# Menit (0-59, UTC) sinkron dimulai tiap jam; bawaan 5.
BILLING_SYNC_MINUTE=5
# Penjaga penyusutan: sinkron ditolak bila jumlah tagihan di bawah persen ini dari
# sinkron sukses terakhir (0 mematikan penjaga; bawaan 50), hanya bila sinkron
# sukses terakhir punya setidaknya BILLING_DROP_MIN_INVOICES tagihan (bawaan 10).
BILLING_DROP_PERCENT=50
BILLING_DROP_MIN_INVOICES=10

# ==============================================================================
# 8. Backend Go & Realtime WebSocket Engine
# ==============================================================================
# Where the browser reaches the Go backend (origin only).
BACKEND_URL=http://localhost:8080
# Where the NEXT.JS SERVER itself reaches the Go backend (billing sync, TR-069
# binding, etc.) -- not the browser. Empty falls back to BACKEND_URL, which is
# correct outside Docker (same host). Inside Docker it must be the Compose
# service name (e.g. http://backend:8080), since the app container's
# "localhost" is itself, not the backend container. See compose.yaml.
BACKEND_INTERNAL_URL=
# Shared with the Go backend (backend/). It signs the short-lived login tickets for
# the WebSocket and REST API. npm run setup generates it; use the same value on
# both sides. The backend disables /ws and /api/v1/ when it is empty.
REALTIME_TOKEN_SECRET=
# Token rahasia untuk webhook PPP dari router (kirim lewat header, bukan URL).
PPP_WEBHOOK_TOKEN=
# Port HTTP backend Go, alamat penerima syslog (UDP) dan NetFlow.
PORT=8080
SYSLOG_ADDR=0.0.0.0:514
NETFLOW_ADDR=:2055

# ==============================================================================
# 9. Keamanan & Kunci Enkripsi Kredensial
# ==============================================================================
# Kunci enkripsi AES-256-GCM untuk kredensial perangkat (router/OLT) yang
# disimpan di database. Tepat 32 karakter (32 byte), acak, dan dijaga rahasia.
# Mengganti nilainya membuat kredensial tersimpan tak terbaca lagi.
DEVICE_SECRET=
# Kunci API gateway WhatsApp untuk notifikasi alert.
WHATSAPP_API_KEY=

# ==============================================================================
# 10. Akun Awal & Lab Opsional
# ==============================================================================
# Akun awal untuk npm run seed:accounts (semua opsional): satu admin yang boleh
# mengubah data dan satu akun hanya-lihat. Email dan nama juga bisa lewat
# argumen. Biarkan kata sandi KOSONG agar dibuat acak dan dicetak sekali di
# terminal; jangan menaruh kata sandi sungguhan di berkas yang masuk git. Di
# NODE_ENV=production email bawaan @noc.local ditolak, jadi isi email asli.
# Contoh nilai: admin@noc.local / Admin NOC / viewer@noc.local / Petugas Hanya Lihat
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_VIEWER_EMAIL=
SEED_VIEWER_NAME=
SEED_VIEWER_PASSWORD=
# Lab Uji Banding Docker & TimescaleDB
LAB_POSTGRES_PORT=5433
TIMESCALE_ENABLED=false
TRAFFIC_RETENTION_DAYS=30
