# npm run setup creates private local values in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433

# Shared with the Go backend (backend/). It signs the short-lived login tickets for
# the WebSocket and REST API. npm run setup generates it; use the same value on
# both sides. The backend disables /ws and /api/v1/ when it is empty.
REALTIME_TOKEN_SECRET=
# Where the browser reaches the Go backend (origin only).
BACKEND_URL=http://localhost:8080
# "demo" shows the dashboard with mock data. "live" locks it until at least one
# router or OLT is installed and reachable; users are sent to /setup until then.
DASHBOARD_DATA=demo
